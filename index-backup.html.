<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AI Worker Empire | Empire OS</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:18px;background:#0b1220;color:#f3f5fa;font:15px Arial,sans-serif}
h1{color:#efc576;font-size:27px;margin:8px 0}
h2{font-size:20px}
p{color:#b5c2d5}
header{display:flex;justify-content:space-between;align-items:center;gap:12px}
.tag{font-size:11px;background:#173d36;color:#9de8c9;padding:9px;border-radius:20px}
nav{display:flex;overflow-x:auto;gap:8px;padding:18px 0}
button{background:#263b58;color:#fff;border:1px solid #536680;border-radius:9px;padding:12px;cursor:pointer}
nav button{white-space:nowrap}
.card{background:#1b2940;border:1px solid #344860;border-radius:14px;padding:16px;margin:12px 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.worker{background:#101e32;border-radius:10px;padding:12px}
.small{font-size:12px;color:#a8b7ca}
.gold{background:#c89a48;color:#0b1220;font-weight:bold}
.red{background:#963444}
input{width:100%;padding:13px;background:#0b1220;border:1px solid #64748b;color:white;border-radius:8px;margin:8px 0}
section{display:none}
section.active{display:block}
.item{padding:12px 0;border-bottom:1px solid #344860}
.good{color:#8de0b8}
</style>
</head>
<body>
<header>
<div><small>EMPIRE OS / HEADQUARTERS</small><h1>AI Worker Empire</h1></div>
<span class="tag" id="status">DEMO MODE</span>
</header>
<p>Your digital business headquarters</p>
<nav>
<button onclick="show('crew')">CREW</button>
<button onclick="show('tasks')">MISSIONS</button>
<button onclick="show('trends')">TRENDS</button>
<button onclick="show('business')">DIVISIONS</button>
<button onclick="show('memory')">MEMORY</button>
</nav>
<section id="crew" class="active">
<h2>CREW Station</h2>
<div class="card"><div class="grid" id="workers"></div></div>
<div class="card"><b>Emergency Stop</b><p id="stoptext">Local dashboard controls enabled.</p><button class="red" onclick="toggleStop()">STOP / RESUME</button></div>
</section>
<section id="tasks">
<h2>Mission Control</h2>
<div class="card"><p>Create an assignment for your future AI workforce.</p><input id="mission" placeholder="Enter a mission"><button class="gold" onclick="addTask()">Create Mission</button></div>
<div class="card" id="tasklist"></div>
</section>
<section id="trends">
<h2>Trend Intelligence</h2>
<div class="card"><input id="trend" placeholder="Enter a market trend"><button onclick="addTrend()">Save Trend</button><div id="trendlist"></div></div>
</section>
<section id="business">
<h2>Empire Divisions</h2>
<div class="grid" id="divisions"></div>
</section>
<section id="memory">
<h2>Memory Vault</h2>
<div class="card"><p>Your missions and trends are saved in this browser on this device.</p><button onclick="backup()">Export Backup</button><button class="red" onclick="clearAll()">Clear Records</button></div>
</section>
<p class="small">Prototype dashboard. No live AI agents, trading, or automatic publishing connected yet.</p>
<script>
const roles=['AI Director','Trend Scout','Product Builder','Trading Analyst','Publishing Agent','Motion Studio','Quality Inspector','Operations'];
const units=['Trend Intelligence','E-commerce','Trading Lab','Publishing House','Motion Studios','Music & Radio','Sourcing','Services'];
let tasks=JSON.parse(localStorage.getItem('empireTasks')||'[]');
let trends=JSON.parse(localStorage.getItem('empireTrends')||'[]');
let stopped=false;
function show(id){
document.querySelectorAll('section').forEach(s=>s.classList.remove('active'));
document.getElementById(id).classList.add('active');
}
function render(){
document.getElementById('workers').innerHTML=roles.map((r,i)=>'<div class="worker"><b>'+r+'</b><p class="small">Worker '+(i+1)+'</p><span class="good">'+(stopped?'Paused':'Available')+'</span></div>').join('');
document.getElementById('divisions').innerHTML=units.map(u=>'<div class="card">'+u+'</div>').join('');
let list=document.getElementById('tasklist');
list.innerHTML='';
tasks.forEach((t,i)=>{
let d=document.createElement('div');
d.className='item';
let b=document.createElement('b');b.textContent=t.name;
let p=document.createElement('p');p.className='small';p.textContent=t.done?'Manually completed':'Awaiting assignment';
let btn=document.createElement('button');btn.textContent='Mark Complete';btn.disabled=t.done;btn.onclick=()=>completeTask(i);
d.append(b,p,btn);list.appendChild(d);
});
let tl=document.getElementById('trendlist');tl.innerHTML='';
trends.forEach(t=>{let p=document.createElement('p');p.textContent='• '+t;tl.appendChild(p)});
document.getElementById('status').textContent=stopped?'PAUSED':'DEMO MODE';
document.getElementById('stoptext').textContent=stopped?'Local actions paused.':'Local dashboard controls enabled.';
}
function save(){
localStorage.setItem('empireTasks',JSON.stringify(tasks));
localStorage.setItem('empireTrends',JSON.stringify(trends));
}
function addTask(){
if(stopped)return alert('Dashboard paused');
let v=document.getElementById('mission').value.trim();
if(!v)return;
tasks.push({name:v,done:false});save();
document.getElementById('mission').value='';render();
}
function completeTask(i){
if(stopped)return alert('Dashboard paused');
tasks[i].done=true;save();render();
}
function addTrend(){
if(stopped)return alert('Dashboard paused');
let v=document.getElementById('trend').value.trim();
if(!v)return;
trends.push(v);save();
document.getElementById('trend').value='';render();
}
function toggleStop(){stopped=!stopped;render();}
function backup(){
let a=document.createElement('a');
a.href=URL.createObjectURL(new Blob([JSON.stringify({tasks,trends},null,2)],{type:'application/json'}));
a.download='empire-backup.json';a.click();
}
function clearAll(){
if(confirm('Delete all local missions and trends?')){
tasks=[];trends=[];save();render();
}
}
render();
</script>
<style>
#contracts{display:block}
#contracts .contract-panel{background:#1b2940;border:1px solid #344860;border-radius:14px;padding:15px;margin:12px 0}
#contracts label{display:block;margin-top:10px;font-size:13px;color:#c9d5e5}
#contracts input,#contracts textarea,#contracts select{width:100%;padding:11px;margin:6px 0;background:#0b1220;color:white;border:1px solid #64748b;border-radius:8px;font:inherit}
#contracts textarea{min-height:72px}
#contracts button{margin:5px 5px 5px 0}
#contracts .contract-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#contracts .contract-stats div{background:#101e32;border-radius:9px;padding:12px}
#contracts small{color:#a8b7ca}
</style>
<div id="contracts" class="contract-panel" style="margin-top:30px">
<h2>Contract Acquisition Division</h2>
<p>Nationwide opportunity intelligence • Manual research workspace</p>
<div class="contract-panel">
<h3>Opportunity Radar</h3>
<p><a href="https://sam.gov/opportunities" target="_blank" rel="noopener" style="color:#efc576">Search federal contracts — SAM.gov</a></p>
<p><a href="https://legacy.sba.gov/federal-contracting/contracting-guide/prime-subcontracting/subcontracting-opportunities" target="_blank" rel="noopener" style="color:#efc576">Search subcontracting — SBA SUBNet</a></p>
<p><a href="https://www.sba.gov/counseling/how-to-win-contracts/" target="_blank" rel="noopener" style="color:#efc576">Learn bidding requirements — SBA</a></p>
<small>These links open official sources. Results are not automatically imported.</small>
</div>
<div class="contract-panel">
<h3>New / Edit Opportunity</h3>
<input id="dealTitle" placeholder="Contract title or business opportunity">
<input id="dealBuyer" placeholder="Buyer / agency / prime contractor">
<input id="dealLocation" placeholder="Location or nationwide">
<input id="dealUrl" placeholder="Official opportunity URL">
<label>Bid deadline</label><input id="dealDeadline" type="date">
<label>Acquisition route</label>
<select id="dealRoute"><option>Prime contract</option><option>Subcontract</option><option>Private commercial deal</option></select>
<label>Stage</label>
<select id="dealStage"><option>Discovered</option><option>Evaluating</option><option>Preparing bid</option><option>Submitted</option><option>Awarded</option><option>Staffing</option><option>Operating</option></select>
<textarea id="dealNotes" placeholder="Eligibility, licensing, insurance, startup capital, risks, next steps"></textarea>
<button onclick="saveDeal()">Save Opportunity</button>
<button onclick="resetDeal()">New / Clear</button>
<div id="dealList"></div>
</div>
<div class="contract-panel">
<h3>Profitability Calculator</h3>
<label>Estimated total contract revenue ($)</label><input id="rev" type="number" min="0" placeholder="0">
<label>Labor and subcontracting ($)</label><input id="labor" type="number" min="0" placeholder="0">
<label>Materials, equipment, insurance ($)</label><input id="materials" type="number" min="0" placeholder="0">
<label>Other expenses, financing and contingency ($)</label><input id="other" type="number" min="0" placeholder="0">
<button onclick="calcDeal()">Calculate</button>
<div class="contract-stats">
<div><small>Estimated operating profit</small><h3 id="profit">$0</h3></div>
<div><small>Estimated margin</small><h3 id="margin">0%</h3></div>
</div>
<small>Planning estimates only; account for taxes, payment delays, and additional risks.</small>
</div>
<div class="contract-panel">
<h3>Staffing Planner</h3>
<label>Workers required</label><input id="heads" type="number" min="0" placeholder="0">
<label>Hours per worker</label><input id="hours" type="number" min="0" placeholder="0">
<label>Hourly wage ($)</label><input id="wage" type="number" min="0" placeholder="0">
<label>Payroll burden and benefits (%)</label><input id="burden" type="number" min="0" value="20">
<button onclick="calcStaff()">Estimate Staffing Cost</button>
<p id="staffResult"></p>
</div>
<div class="contract-panel">
<h3>Bid-to-Business Roadmap</h3>
<ol>
<li>Verify the original solicitation and deadline</li>
<li>Check eligibility, registration, licenses and insurance</li>
<li>Confirm performance requirements and payment terms</li>
<li>Price labor, supplies, subcontractors and contingency</li>
<li>Prepare the required bid documents</li>
<li>Review and approve before submission</li>
<li>Confirm award and contract execution</li>
<li>Recruit or engage qualified workers</li>
<li>Deliver, document and invoice the work</li>
</ol>
<p><small>Worker hiring and bid submission require owner approval.</small></p>
</div>
</div>
<script>
(function(){
let deals=JSON.parse(localStorage.getItem('empireDealsV1')||'[]');
let editing=-1;
const $=id=>document.getElementById(id);
const fields=['Title','Buyer','Location','Url','Deadline','Route','Stage','Notes'];
function readForm(){let d={};fields.forEach(k=>d[k.toLowerCase()]=$('deal'+k).value);return d}
function writeForm(d){fields.forEach(k=>$('deal'+k).value=d[k.toLowerCase()]||'')}
function persist(){localStorage.setItem('empireDealsV1',JSON.stringify(deals));renderDeals()}
window.resetDeal=function(){editing=-1;writeForm({})};
window.saveDeal=function(){
let d=readForm();if(!d.title.trim())return alert('Enter a title');
if(editing<0)deals.push(d);else deals[editing]=d;
persist();resetDeal();
};
window.editDeal=function(i){editing=i;writeForm(deals[i]);$('dealTitle').scrollIntoView({behavior:'smooth'})};
window.deleteDeal=function(i){if(confirm('Delete this opportunity?')){deals.splice(i,1);persist();resetDeal()}};
function renderDeals(){
let root=$('dealList');root.replaceChildren();
deals.forEach((d,i)=>{
let box=document.createElement('div');box.style='border-top:1px solid #52617a;padding:12px 0';
let title=document.createElement('b');title.textContent=d.title;
let details=document.createElement('p');details.textContent=[d.buyer,d.location,d.stage,d.deadline].filter(Boolean).join(' • ');
let edit=document.createElement('button');edit.textContent='Edit';edit.onclick=()=>editDeal(i);
let del=document.createElement('button');del.textContent='Delete';del.onclick=()=>deleteDeal(i);
box.append(title,details);
if(/^https:\/\//i.test(d.url)){let link=document.createElement('a');link.href=d.url;link.target='_blank';link.rel='noopener';link.textContent='Official source';link.style='color:#efc576;display:block;margin-bottom:8px';box.append(link)}
box.append(edit,del);root.append(box);
});
}
const num=id=>Math.max(0,Number($(id).value)||0);
const money=n=>n.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2});
window.calcDeal=function(){let revenue=num('rev'),cost=num('labor')+num('materials')+num('other'),profit=revenue-cost;$('profit').textContent=money(profit);$('margin').textContent=revenue?(100*profit/revenue).toFixed(1)+'%':'N/A'};
window.calcStaff=function(){let total=num('heads')*num('hours')*num('wage')*(1+num('burden')/100);$('staffResult').textContent='Estimated loaded labor cost: '+money(total)};
renderDeals();
})();
</script>
<style>
#concierge{display:block;background:#101c30;color:#fff;border:1px solid #344860;border-radius:16px;padding:16px;margin:20px 0}
#concierge .cc-card{background:#1b2940;border-radius:12px;padding:14px;margin:12px 0}
#concierge textarea{width:100%;min-height:110px;padding:12px;background:#0b1220;color:white;border:1px solid #64748b;border-radius:9px;font:inherit}
#concierge button{margin:5px 5px 5px 0}
#concierge .cc-note{font-size:12px;color:#aebbd0}
#concierge .cc-entry{border-top:1px solid #455672;padding:12px 0}
#concierge .cc-entry p{white-space:pre-wrap;overflow-wrap:anywhere}
</style>
<div id="concierge">
<h2>Chief — Business Concierge</h2>
<p>Tell Chief your vision. Build a plan before filling out paperwork.</p>
<div class="cc-card">
<b>Chief — Empire Business Director</b>
<p>What are we working toward today? Describe the opportunity or business you want to build.</p>
<label for="ccRequest">Your request</label>
<textarea id="ccRequest" placeholder="Example: Find overlooked government and private contracts with low startup costs. Show me how to qualify, bid, hire workers, and make a profit."></textarea>
<button onclick="ccSave()">Save Request</button>
<button onclick="ccClear()">Clear Draft</button>
<p class="cc-note">Requests are stored in this browser. This version does not send messages to an AI service.</p>
</div>
<div class="cc-card">
<h3>Mission History</h3>
<div id="ccHistory"></div>
</div>
<div class="cc-card">
<h3>Chief's Planning Framework</h3>
<p>1. Understand your business objective and constraints.</p>
<p>2. Identify what can be researched without interrupting you.</p>
<p>3. Find opportunities and verify official sources.</p>
<p>4. Evaluate eligibility, startup costs, profit, and risks.</p>
<p>5. Develop a bidding and staffing roadmap.</p>
<p>6. Present recommendations for your approval.</p>
<p class="cc-note">These are planned worker steps, not completed research.</p>
</div>
</div>
<script>
(function(){
const key='empireConciergeV1';
let requests=JSON.parse(localStorage.getItem(key)||'[]');
let editing=-1;
const input=document.getElementById('ccRequest');
const history=document.getElementById('ccHistory');
function persist(){localStorage.setItem(key,JSON.stringify(requests));render()}
window.ccClear=function(){editing=-1;input.value=''};
window.ccSave=function(){
const value=input.value.trim();
if(!value)return alert('Describe your request first.');
if(editing===-1)requests.push({text:value,created:new Date().toISOString(),updated:new Date().toISOString()});
else {requests[editing].text=value;requests[editing].updated=new Date().toISOString()}
persist();ccClear();
};
window.ccEdit=function(i){
editing=i;input.value=requests[i].text;input.focus();input.scrollIntoView({behavior:'smooth'});
};
window.ccDelete=function(i){
if(!confirm('Delete this saved request?'))return;
requests.splice(i,1);persist();ccClear();
};
function render(){
history.replaceChildren();
if(!requests.length){let p=document.createElement('p');p.textContent='No saved requests yet.';history.append(p)}
requests.forEach((r,i)=>{
let row=document.createElement('div');row.className='cc-entry';
let p=document.createElement('p');p.textContent=r.text;
let meta=document.createElement('p');meta.className='cc-note';meta.textContent='Updated: '+new Date(r.updated).toLocaleString();
let edit=document.createElement('button');edit.textContent='Edit';edit.onclick=()=>ccEdit(i);
let del=document.createElement('button');del.textContent='Delete';del.onclick=()=>ccDelete(i);
row.append(p,meta,edit,del);history.append(row);
});
}
render();
})();
</script>
</body>
</html>
